# ============================================================
# aibeer — aggressive .gitignore (WSL2/Linux dev + macOS build)
# ============================================================

# ---- Generated web artifacts ----
# Regenerated by CI on push (see .github/workflows/deploy-pages.yml) and
# locally by tools/gate.sh / tools/gen-icons.sh.
# preview/screenshots/ stays COMMITTED: the README embeds those PNGs and
# GitHub renders README images from the repo, not from the Pages site.
preview/index.html
app/index.html
preview/styles.json
app/icons/

# ---- Swift / SwiftPM ----
.build/
*/.build/
.build-*/
*.xcodeproj
*.xcworkspace
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
.swiftpm/
Package.resolved
*.resolved
*.o
*.dSYM
*.dSYM.zip
*.ipa
*.app
*.hmap
*.entitlements-bak
*.gcno
*.gcda
*.profraw
*.profdata
build/

# ---- Xcode misc ----
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-aside
*.xcresult

# ---- Node / Playwright (tooling) ----
node_modules/
.npm/
.npmrc
package-lock.json
yarn.lock
pnpm-lock.yaml
playwright-report/
test-results/
.playwright/
.blob-storage/

# ---- Secrets & signing (CI signing path — NEVER commit) ----
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
AuthKey_*.p8
secrets/
credentials.json

# ---- Logs / temp ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.orig
*.rej
core
core.*

# ---- Editors / IDEs ----
.vscode/
.idea/
.agents/
*.swp
*.swo
*~
.~lock.*
*.sublime-workspace
*.sublime-project
*.code-workspace
.history/
.heynote/

# ---- macOS ----
.DS_Store
._*
.Spotlight-V100
.Trashes
.LSOverride
.fseventsd
Icon?

# ---- Windows / WSL ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
System Volume Information/

# ---- Misc junk ----
*.swp.download
*.crdownload
.part
.~c9*
svn-commit.tmp
